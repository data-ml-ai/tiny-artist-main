# Tiny Artist — environment variables (TEMPLATE ONLY — never commit real values)
# The storefront in index.html works without any of these. They are required
# only for the Phase-2 backend described in SETUP.md (Supabase + server API).

# Supabase project (create at https://supabase.com/dashboard). The publishable
# key is safe to expose in the browser; the secret key is SERVER-ONLY.
# New Supabase dashboard names map to these variables as follows:
#   publishable key (sb_publishable_...) -> SUPABASE_ANON_KEY
#   secret key (sb_secret_...)           -> SUPABASE_SERVICE_ROLE_KEY
# The static frontend reads its URL + publishable key from
# supabase-config.js (no build step injects env vars into the browser);
# these variables are for server code / Vercel settings only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# SERVER ONLY — set in Vercel project settings, never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp destination for orders (international format, no + or spaces).
# The storefront currently uses the same number hard-coded in index.html
# (WA_NUMBER). Keep both in sync if the number ever changes.
WHATSAPP_NUMBER=923098426672

# Admin allowlist is enforced in the DATABASE (see backend/supabase/schema.sql),
# not by this variable. Listed here only as documentation of intent:
# ADMIN_EMAILS=moosamahmood20002512@gmail.com,asadvendor0@gmail.com
