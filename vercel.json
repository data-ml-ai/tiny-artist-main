{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "headers": [
  {
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=()"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains; preload"
    }
   ],
   "source": "/(.*)"
  },
  {
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ],
   "source": "/assets/(.*)"
  }
 ],
 "rewrites": [
  {
   "source": "/admin",
   "destination": "/admin.html"
  },
  {
   "source": "/admin/",
   "destination": "/admin.html"
  }
 ]
}